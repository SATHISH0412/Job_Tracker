# Environment variables
#
# Copy this file to `.env.local` and fill in only what you actually need:
#
#   Windows:      copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed. This file is
# committed and must always keep every value empty.
#
# V1 needs NONE of these. The app runs fully with no `.env.local` at all.
# They are reserved now so later plans do not have to rename anything.
#
# Only `lib/env.ts` may read `process.env`. No other file may touch it
# directly. Nothing outside a `NEXT_PUBLIC_`-prefixed variable ever reaches
# the browser, so these values cannot leak into a client bundle.

# Server-only. PostgreSQL connection string. First used by
# 05-job-persistence. V1 has no database.
DATABASE_URL=

# Server-only. LinkedIn API key. V1 never calls LinkedIn — it builds a
# public search URL and hands it to your own browser — so this stays empty
# for the whole of V1.
LINKEDIN_API_KEY=

# Server-only. Google Gemini API key. First used by 08-ai-matching.
GEMINI_API_KEY=

# Server-only. OpenRouter API key. First used by 08-ai-matching.
OPENROUTER_API_KEY=

# Server-only. Secret used to sign session cookies. First used by
# 04-private-access-and-handoff.
AUTH_SECRET=
